# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# Deployer key. Use a fresh key that holds only the BNB needed for deployment.
DEPLOYER_PRIVATE_KEY=

# Ownership of the deployed system. Use a Gnosis Safe multisig on mainnet —
# a single EOA holding DEFAULT_ADMIN_ROLE is a finding any auditor will raise.
ADMIN_ADDRESS=
TREASURY_ADDRESS=
CUSTODIAN_ADDRESS=

# RPC endpoints (public defaults are used if unset; a paid endpoint is worth it
# for the keeper, which sends transactions continuously).
BSC_RPC=https://bsc-dataseed.bnbchain.org
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# One Etherscan V2 API key covers BscScan. Get it at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# ---------------------------------------------------------------------------
# Keeper — one key per price source. These must match the addresses passed to
# addSource(), in the same order the sources are built in keeper/index.ts.
# ---------------------------------------------------------------------------
KEEPER_NETWORK=bscTestnet
KEEPER_INTERVAL_MS=300000
REPORTER_KEY_0=
REPORTER_KEY_1=
REPORTER_KEY_2=
REPORTER_KEY_3=

BINANCE_SYMBOL=PAXGUSDT
OKX_INST_ID=PAXG-USDT

# Optional: a market-maker desk RFQ endpoint returning {bid, ask, size}
MM_QUOTE_URL=
MM_QUOTE_AUTH=

# Optional: fund administrator NAV endpoint returning {nav, asOf, units}
NAV_FEED_URL=
NAV_FEED_AUTH=

# ---------------------------------------------------------------------------
# Business flow script
# ---------------------------------------------------------------------------
# Demo participant wallets, comma separated. Real beta users interact through
# the dApp with their own wallets — these are only for the scripted reference run.
USER_PRIVATE_KEYS=
RESERVE_UNITS=100
RESERVE_PROOF_URI=
KYC_EVIDENCE_URI=
MINT_UNITS=10
RUN_REDEMPTION=false
